# --- Options globales ---
# Access log JSON, lu par fail2ban sur l'hôte via le
# montage {{ ssd_mountpoint }}/appdata/caddy/logs -> /var/log/caddy.
{
    log {
        output file /var/log/caddy/access.log
        format json {
            time_format iso8601
        }
    }
}

# Remplace {{ public_domain }} (variable group_vars/all.yml) par ton
# vrai nom de domaine.
#
# Deux couches indépendantes sur toutes les apps (sauf sso lui-même) :
# - lan_only (réseau) : coupe toute connexion qui ne vient pas d'une plage
#   privée, avant même que la requête n'atteigne VoidAuth.
# - voidauth_auth (identité) : forward_auth vers VoidAuth, même compte pour
#   tout le monde.
#
# jellyfin/seerr sont pensés pour être accessibles depuis internet un jour
# (port-forward sur le routeur) : uniquement voidauth_auth pour eux.
# sonarr/radarr/prowlarr/qbittorrent restent des outils d'admin : les deux
# couches, LAN et VoidAuth, pour ne jamais compter uniquement sur leur
# propre système d'authentification interne (voir CVE-2026-30975 sur
# Sonarr : le mode "Disabled for Local Addresses" peut être contourné si le
# reverse proxy devant n'est pas irréprochable sur X-Forwarded-For — pense
# à passer leur "Authentication Required" sur Enabled dans chaque app,
# VoidAuth devient la seule porte d'entrée fiable).

# --- Snippets ---

(voidauth_auth) {
    # Important : on supprime d'abord toute valeur de ces headers envoyée
    # par le client lui-même. copy_headers ne fait que les DEFINIR si
    # VoidAuth les renvoie dans sa réponse ; il ne les supprime jamais côté
    # requête entrante. Sans ce strip, un client pourrait injecter son
    # propre "Remote-User: admin" et le voir transmis tel quel au backend
    # si jamais VoidAuth ne repositionne pas le header sur un chemin donné.
    request_header -Remote-User
    request_header -Remote-Groups
    request_header -Remote-Name
    request_header -Remote-Email

    forward_auth 127.0.0.1:3000 {
        uri /api/authz/forward-auth
        copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
    }
}

# private_ranges = 192.168.0.0/16, 172.16.0.0/12, 10.0.0.0/8, 127.0.0.1/8,
# fd00::/8, ::1 (cf. doc Caddy). Coupe la connexion (abort, pas de réponse
# HTTP) pour tout ce qui n'est pas dans ces plages.
(lan_only) {
    @denied not remote_ip private_ranges
    abort @denied
}

(access_log) {
    log
}

# --- VoidAuth (SSO) ---
# Doit rester accessible partout où jellyfin/seerr le sont : c'est vers ce
# domaine que forward_auth redirige les visiteurs non authentifiés. Pas de
# lan_only ici : sinon un visiteur externe de jellyfin serait redirigé vers
# une page de login qu'il ne peut pas atteindre.

sso.{{ public_domain }} {
    tls internal
    log {
        output file /var/log/caddy/sso-access.log
        format json {
            time_format iso8601
        }
    }
    reverse_proxy 127.0.0.1:3000
}

# --- Apps grand public, derrière VoidAuth ---

jellyfin.{{ public_domain }} {
    tls internal
    import access_log
    import voidauth_auth
    reverse_proxy 127.0.0.1:8096
}

seerr.{{ public_domain }} {
    tls internal
    import access_log
    import voidauth_auth
    reverse_proxy 127.0.0.1:5055
}

# --- Outils d'admin : LAN + VoidAuth, les deux couches ---

sonarr.{{ public_domain }} {
    tls internal
    import access_log
    import lan_only
    import voidauth_auth
    reverse_proxy 127.0.0.1:8989
}

radarr.{{ public_domain }} {
    tls internal
    import access_log
    import lan_only
    import voidauth_auth
    reverse_proxy 127.0.0.1:7878
}

prowlarr.{{ public_domain }} {
    tls internal
    import access_log
    import lan_only
    import voidauth_auth
    reverse_proxy 127.0.0.1:9696
}

qbittorrent.{{ public_domain }} {
    tls internal
    import access_log
    import lan_only
    import voidauth_auth
    reverse_proxy 127.0.0.1:8080
}
