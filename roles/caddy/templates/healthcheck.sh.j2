#!/bin/sh
# Généré par Ansible (roles/caddy/templates/healthcheck.sh.j2)
#
# HealthCmd pour caddy.container.j2. Nécessaire pour que
# `podman auto-update --rollback` puisse détecter une image cassée.
#
# Pas de /dev/tcp ici (contrairement à une première version) : le paquet
# bash de Debian (utilisé par l'image officielle caddy) est compilé sans
# --enable-net-redirections, donc /dev/tcp/HOST/PORT n'existe pas malgré
# la présence de bash dans l'image (RHEL/Fedora/upstream l'ont, Debian non,
# choix de durcissement des mainteneurs Debian) - le test échouait avec
# "nonexistent directory" avant même de tenter une connexion, sans rien
# dire de l'état réel de Caddy.
#
# On inspecte donc /proc/net/tcp et /proc/net/tcp6 directement : la ligne
# du port en écoute (état 0A = LISTEN) y apparaît quel que soit le shell,
# sans dépendance externe (grep suffit, présent dans l'image de base).
PORT_HEX=01BB  # 443 en hexadécimal

if grep -qE ":$PORT_HEX [0-9A-F]+:[0-9A-F]+ 0A" /proc/net/tcp /proc/net/tcp6 2>/dev/null; then
    exit 0
else
    exit 1
fi