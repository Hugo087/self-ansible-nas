[Unit]
Description=Jellyfin - serveur multimedia
After=network-online.target

[Container]
ContainerName=jellyfin
Image=lscr.io/linuxserver/jellyfin:latest
AutoUpdate=registry

Network=media.network
PublishPort=127.0.0.1:8096:8096

Environment=TZ=Europe/Paris
Environment=PUID={{ quadlet_uid }}
Environment=PGID={{ quadlet_gid }}

UserNS=keep-id

AddDevice=/dev/dri/:/dev/dri/

Volume={{ ssd_mountpoint }}/appdata/jellyfin/config:/config:Z
Volume={{ hdd_mountpoint }}/media/tvshows:/data/tvshows:z,ro
Volume={{ hdd_mountpoint }}/media/movies:/data/movies:z,ro

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=default.target