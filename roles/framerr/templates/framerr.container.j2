[Unit]
Description=Framerr - dashboard homelab (widgets + tabs iframe)
After=network-online.target

[Container]
ContainerName=framerr
Image=docker.io/pickels23/framerr:latest
AutoUpdate=registry

Network=media.network
PublishPort=127.0.0.1:3001:3001

Environment=TZ=Europe/Paris
Environment=PUID={{ quadlet_uid }}
Environment=PGID={{ quadlet_gid }}

UserNS=keep-id

EnvironmentFile={{ ssd_mountpoint }}/appdata/framerr/framerr.env

Volume={{ ssd_mountpoint }}/appdata/framerr/config:/config:Z
Volume={{ ssd_mountpoint }}/appdata/framerr/healthcheck.sh:/usr/local/bin/healthcheck.sh:Z,ro

# Voir roles/framerr/templates/healthcheck.sh.j2 pour le détail du choix
# technique (test TCP, pas d'endpoint applicatif documenté).
HealthCmd=sh /usr/local/bin/healthcheck.sh
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=30s
Notify=healthy
HealthOnFailure=kill

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=default.target
