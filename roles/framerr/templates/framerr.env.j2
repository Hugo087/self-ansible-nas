# Généré par Ansible - ne pas éditer à la main
# (roles/framerr/templates/framerr.env.j2)
#
# Clé de chiffrement (AES-256-GCM côté Framerr) des identifiants
# d'intégration stockés en base (API keys Sonarr/Radarr/Seerr/qBittorrent...).
# Génère-la une seule fois avec `openssl rand -hex 32` et colle le résultat
# dans vault_framerr_secret_encryption_key (group_vars/all/vault.yml) - la
# changer après coup rend illisibles les intégrations déjà configurées dans
# Framerr (mêmes conséquences qu'une rotation de clé chez VoidAuth).

SECRET_ENCRYPTION_KEY={{ vault_framerr_secret_encryption_key }}
