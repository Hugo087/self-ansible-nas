[global]
   workgroup = {{ samba_workgroup }}
   server string = {{ samba_server_string }}
   security = user
   # never (pas bad user) : un identifiant invalide est rejeté plutôt que
   # retombé en session invité - aucun partage de ce fichier n'est prévu
   # pour être accessible sans authentification.
   map to guest = never
   hosts allow = 127. {{ trusted_networks | join(' ') }}
   hosts deny = 0.0.0.0/0
   # Durcissement protocole : coupe SMB1 (obsolète, sans intérêt ici vu
   # les clients modernes) et impose l'intégrité/chiffrement du transport.
   server min protocol = SMB2_10
   client min protocol = SMB2_10
   server signing = mandatory
   smb encrypt = required

[SSD]
   comment = SSD Storage (usage personnel uniquement - pas appdata/podman)
   path = {{ samba_shared_dir }}
   valid users = {{ samba_valid_users | join(',') }}
   read only = no
   create mask = 0644
   directory mask = 0755
   browseable = yes

[Media]
   comment = Bibliotheque media (Sonarr/Radarr/qBittorrent)
   path = {{ hdd_mountpoint }}/media
   valid users = {{ samba_valid_users | join(',') }}
   read only = no
   force group = {{ media_user }}
   create mask = 0664
   directory mask = 2775
   browseable = yes

[homes]
   comment = Home Directories
   valid users = %S
   read only = no
   create mask = 0700
   directory mask = 0700
   browseable = no