[Unit]
Description=qBittorrent
After=network-online.target
# Quadlet ajoute déjà automatiquement Requires=/After=gluetun.service grâce
# au Network= ci-dessous. PartOf= en plus est nécessaire pour que qBittorrent
# soit arrêté/redémarré à chaque fois que gluetun.service redémarre (mise à
# jour d'image, restart manuel...) : sans ça, un restart de gluetun casse
# silencieusement le netns partagé et qBittorrent reste sans réseau jusqu'à
# un restart manuel.
PartOf=gluetun.service

[Container]
ContainerName=qbittorrent
Image=lscr.io/linuxserver/qbittorrent:latest
AutoUpdate=registry

# Tout le trafic de qBittorrent (WebUI + P2P) passe par le netns de gluetun :
# plus aucun PublishPort ici, ils sont déclarés côté gluetun.container.
Network=gluetun.container

Environment=TZ=Europe/Paris
Environment=WEBUI_PORT=8080

Volume={{ ssd_mountpoint }}/appdata/qbittorrent/config:/config:Z
Volume={{ hdd_mountpoint }}/media/downloads:/downloads:z

HealthCmd=wget --no-verbose --tries=1 --spider http://localhost:8080/ || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=60s
Notify=healthy
HealthOnFailure=kill

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=default.target