# Généré par Ansible (roles/zfs/templates/cockpit.conf.j2)
#
# Cockpit vérifie par défaut que l'en-tête Origin des requêtes correspond
# exactement à l'adresse sur laquelle il écoute lui-même (protection
# anti-CSRF) : sans ça, passer par Caddy sur cockpit.{{ public_domain }}
# serait rejeté. Origins doit lister explicitement le domaine utilisé pour
# y accéder. ProtocolHeader/ForwardedForHeader indiquent à Cockpit de faire
# confiance aux en-têtes X-Forwarded-* que Caddy ajoute automatiquement
# (adresse IP réelle du client dans les journaux/l'audit Cockpit, plutôt
# que 127.0.0.1 pour toutes les connexions).
#
# À vérifier après le premier déploiement (je n'ai pas pu tester ça sur un
# vrai Cockpit) : ouvre https://cockpit.{{ public_domain }} et confirme
# que la page de login s'affiche sans erreur liée à l'Origin dans la
# console du navigateur. Si ça bloque, la doc Cockpit sur le reverse
# proxying (page "Cockpit and reverse proxies" sur cockpit-project.org)
# est la référence à jour.
[WebService]
Origins = https://cockpit.{{ public_domain }} https://127.0.0.1:9090
ProtocolHeader = X-Forwarded-Proto
ForwardedForHeader = X-Forwarded-For
