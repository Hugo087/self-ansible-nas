# Généré par Ansible - ne pas éditer à la main
# (roles/beszel/templates/beszel-agent.env.j2)
#
# TOKEN vide tant que le bootstrap manuel du hub n'a pas été fait (voir
# README, section Monitoring) : l'agent tournera mais restera
# "déconnecté" dans le hub jusque-là, ce qui est attendu.

KEY={{ beszel_hub_key }}
TOKEN={{ vault_beszel_tokens[quadlet_user] }}
HUB_URL=http://127.0.0.1:{{ beszel_hub_port }}
LISTEN={{ beszel_agent_listen_ports[quadlet_user] }}
