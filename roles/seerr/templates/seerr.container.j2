[Unit]
Description=Seerr - requetes Jellyfin (ex Overseerr/Jellyseerr)
After=network-online.target

[Container]
ContainerName=seerr
Image=ghcr.io/seerr-team/seerr:preview-new-oidc
AutoUpdate=registry

Network=media.network
PublishPort=127.0.0.1:5055:5055

Environment=TZ=Europe/Paris

# Pas de PUID/PGID ici : contrairement a l'ancien Jellyseerr, cette image
# ne les supporte plus. On fixe directement l'utilisateur du process avec
# User=, aligne sur l'UID/GID de svc-media pour que UserNS=keep-id mappe
# correctement les fichiers vers svc-media cote hote.
User={{ quadlet_uid }}:{{ quadlet_gid }}
UserNS=keep-id

Volume={{ ssd_mountpoint }}/appdata/seerr/config:/app/config:Z
Volume={{ ssd_mountpoint }}/appdata/seerr/healthcheck.sh:/usr/local/bin/healthcheck.sh:Z,ro

# Voir roles/seerr/templates/healthcheck.sh.j2 pour le détail du choix
# technique (test TCP, pas d'endpoint applicatif confirmé pour ce fork).
HealthCmd=sh /usr/local/bin/healthcheck.sh
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=30s
Notify=healthy
HealthOnFailure=kill

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=default.target
