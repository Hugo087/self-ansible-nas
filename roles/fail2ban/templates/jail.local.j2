[DEFAULT]
bantime = 1h
findtime = 10m
maxretry = 5
banaction = firewallcmd-rich-rules
ignoreip = 127.0.0.1/8 ::1 {{ fail2ban_ignore_networks }}
# Bannissement progressif : un attaquant qui revient après l'expiration de
# son ban se voit infliger un temps de bannissement multiplié par 2 à
# chaque récidive (1h, 2h, 4h, 8h... jusqu'au plafond ci-dessous), plutôt
# qu'un bantime fixe qu'il suffit d'attendre patiemment.
bantime.increment = true
bantime.factor = 2
bantime.maxtime = 1w

[caddy-auth]
enabled = true
filter = caddy-auth
logpath = {{ caddy_log_folder }}/sso-access.log
maxretry = 10
findtime = 5m
bantime = 1h

[caddy-scan]
enabled = true
filter = caddy-scan
logpath = {{ caddy_log_folder }}/access.log
maxretry = 20
findtime = 2m
bantime = 1h

[sshd]
enabled = true
maxretry = 10
findtime = 5m
bantime = 1h

[recidive]
enabled = true
filter = recidive
backend = systemd
journalmatch = _SYSTEMD_UNIT=fail2ban.service
bantime = 1w
findtime = 1d
maxretry = 3