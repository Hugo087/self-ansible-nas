# Généré par Ansible - ne pas éditer à la main (roles/wireguard/templates/wg-easy.env.j2)
#
# Contrairement aux exemples docker-compose qu'on trouve dans la doc
# wg-easy, PAS besoin de doubler les caractères $ du hash bcrypt ici : cette
# règle ne concerne que la syntaxe YAML de docker-compose (qui interprète $
# pour la substitution de variables). EnvironmentFile= dans un quadlet est
# lu directement par Podman comme un fichier KEY=VALUE tout simple, sans
# passer par ce mécanisme - le hash généré par `wgpw` se colle donc tel
# quel, guillemets simples inclus si c'est ce que wgpw a affiché.
PASSWORD_HASH={{ vault_wg_easy_password_hash }}
