# Généré par Ansible - ne pas éditer à la main (roles/voidauth/templates/voidauth.env.j2)
# Variables requises par l'image voidauth/voidauth, voir
# https://voidauth.app/#/Getting-Started?id=environment-variables

APP_URL={{ voidauth_app_url }}
DB_ADAPTER=postgres
DB_HOST=voidauth-db
DB_PASSWORD={{ db_password }}
STORAGE_KEY={{ voidauth_storage_key }}
SMTP_HOST=smtp.resend.com
SMTP_USER=resend
SMTP_PASS={{ voidauth_smtp_api_key }}
SMTP_FROM={{ voidauth_from_mail }}
SMTP_SECURE=true
SMTP_PORT=465
APP_TITLE="Chill and play"
DEFAULT_REDIRECT={{ voidauth_redirect_url }}