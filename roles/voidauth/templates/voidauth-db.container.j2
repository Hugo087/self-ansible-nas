[Unit]
Description=Base de donnees PostgreSQL pour VoidAuth
After=network-online.target

[Container]
Image=docker.io/postgres:18
# Le tag est épinglé sur la version majeure (18, pas latest) : AutoUpdate ne
# tirera donc que des correctifs mineurs republiés sous ce tag, jamais un
# saut de version majeure (qui nécessiterait une migration manuelle). Le
# HealthCmd ci-dessous sert de filet de sécurité pour ces mises à jour.
AutoUpdate=registry
ContainerName=voidauth-db
Network=sso.network
# Le mot de passe ne passe plus par Environment= (qui finirait en clair dans
# ce fichier .container, déployé en 0644 et donc lisible par tout compte du
# système) : il vient d'un fichier .env dédié en 0600, comme pour voidauth.env.
EnvironmentFile={{ ssd_mountpoint }}/appdata/voidauth/voidauth-db.env
Volume=voidauth-db-vol:/var/lib/postgresql:Z
HealthCmd=pg_isready -U postgres -h localhost
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=40s
# Notify=healthy : relie ce HealthCmd au rollback de podman-auto-update, ET
# corrige un effet de bord utile - voidauth.service (After=/Requires=
# voidauth-db.service) n'est désormais considéré comme pouvant démarrer
# qu'une fois Postgres réellement prêt à accepter des connexions, pas
# juste une fois le process lancé.
# Pas de HealthOnFailure=kill ici (contrairement à Caddy/PDS/VoidAuth) :
# sur une base de données, mieux vaut laisser une pgbouncer/reconnexion
# applicative gérer un pg_isready ponctuellement en échec (charge, i/o...)
# plutôt que de forcer un redémarrage automatique qui pourrait couper des
# transactions en cours.
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target