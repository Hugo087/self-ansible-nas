[Unit]
Description=Session HTPC (Kodi/Moonlight sous gamescope)
Documentation=man:gamescope(1)
Conflicts=getty@{{ htpc_tty }}.service
After=getty@{{ htpc_tty }}.service systemd-logind.service systemd-user-sessions.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ htpc_user }}
Group={{ htpc_user }}
# PAMName=login : c'est ce qui crée une vraie session logind sur le seat,
# comme le ferait un agetty + login classique. Ça donne à {{ htpc_user }}
# l'accès DRM/input du seat via les ACL dynamiques de systemd-logind, sans
# avoir à écrire de règles udev à la main.
PAMName=login
TTYPath=/dev/{{ htpc_tty }}
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier={{ htpc_tty }}
# %U : spécificateur systemd résolu au démarrage vers l'UID de {{ htpc_user }}
# (pas besoin de faire un id -u côté Ansible comme pour les quadlets Podman).
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=XDG_SESSION_TYPE=tty
ExecStart=/usr/local/bin/htpc-dispatcher.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
