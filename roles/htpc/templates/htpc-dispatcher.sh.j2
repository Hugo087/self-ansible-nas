#!/bin/bash
# Généré par Ansible - ne pas éditer à la main
# (roles/htpc/templates/htpc-dispatcher.sh.j2)
#
# Bascule Kodi <-> Moonlight à l'infini : Kodi est lancé en premier au
# démarrage ; chaque fermeture de l'un relance l'autre, et inversement.
# Chaque appli tourne dans sa propre instance de gamescope (plus simple à
# raisonner qu'un gamescope unique dont on remplacerait le client).
#
# Par défaut gamescope n'expose que du X11 (Xwayland intégré) à ses
# clients, pas un vrai socket Wayland (il faudrait --expose-wayland pour
# ça) : Kodi et Moonlight tournent donc en Xwayland sous gamescope, ce qui
# reste le mode le plus éprouvé pour ce genre de montage. À ajuster ici si
# tu veux forcer d'autres options gamescope (résolution, HDR, etc.) :
# gamescope -W 1920 -H 1080 -- kodi --standalone

set -u

next="kodi"

while true; do
    case "${next}" in
        kodi)
            gamescope --expose-wayland -- kodi --standalone
            next="moonlight"
            ;;
        moonlight)
            gamescope --expose-wayland -- moonlight
            next="kodi"
            ;;
    esac

    # Petite pause pour éviter une boucle de redémarrage trop agressive si
    # l'appli ou gamescope plante immédiatement au lancement.
    sleep 2
done
