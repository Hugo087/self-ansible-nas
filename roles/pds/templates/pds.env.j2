# Généré par Ansible - ne pas éditer à la main (roles/pds/templates/pds.env.j2)
# Variables lues par l'image ghcr.io/bluesky-social/pds - voir
# https://github.com/bluesky-social/pds pour la liste complète.

PDS_HOSTNAME={{ pds_hostname }}
PDS_PORT=3000

# Tout vit sous /pds (monté depuis {{ ssd_mountpoint }}/appdata/pds/data,
# voir pds.container.j2) : base de comptes, blobs uploadés, clés de
# rotation. Pas de conteneur DB séparé comme pour VoidAuth/Immich, le PDS
# utilise SQLite en interne.
PDS_DATA_DIRECTORY=/pds
PDS_BLOBSTORE_DISK_LOCATION=/pds/blocks
PDS_BLOBSTORE_DISK_TMP_LOCATION=/pds/temp

# --- Secrets (group_vars/all/vault.yml) ---
# Voir vault.yml.example pour les commandes de génération - ne JAMAIS les
# régénérer après le premier déploiement (voir commentaire associé).
PDS_JWT_SECRET={{ vault_pds_jwt_secret }}
PDS_ADMIN_PASSWORD={{ vault_pds_admin_password }}
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX={{ vault_pds_plc_rotation_key }}

# --- Réseau AT Protocol officiel (production, pas le sandbox) ---
# Annuaire des DID, AppView pour l'agrégation sociale (fils, notifications,
# recherche...), service de modération, et relay à notifier des mises à
# jour de ce dépôt pour que la fédération fonctionne.
PDS_DID_PLC_URL=https://plc.directory
PDS_BSKY_APP_VIEW_URL=https://api.bsky.app
PDS_BSKY_APP_VIEW_DID=did:web:api.bsky.app
PDS_REPORT_SERVICE_URL=https://mod.bsky.app
PDS_REPORT_SERVICE_DID=did:plc:ar7c4by46qjdydhdevvrndac
PDS_CRAWLERS=https://bsky.network

# Suffixe pour les handles type <compte>{{ pds_service_handle_domain }} -
# voir le commentaire sur pds_hostname (group_vars/all/vars.yml) : ne
# fonctionne vraiment qu'avec un DNS wildcard en plus, non géré par ce
# playbook.
PDS_SERVICE_HANDLE_DOMAINS={{ pds_service_handle_domain }}

# Inscriptions sur invitation uniquement (choix fait pour ce déploiement) :
# personne ne peut créer de compte sans un code généré au préalable par un
# admin (voir README, section PDS, pour la commande curl). C'est déjà la
# valeur par défaut de l'image - explicité ici pour ne pas en dépendre
# implicitement si ça changeait dans une future version.
PDS_INVITE_REQUIRED=true

# Email transactionnel (confirmation de compte, réinitialisation de mot de
# passe) - réutilise le même compte Resend que VoidAuth plutôt que
# d'ajouter un secret dédié pour ça (voir voidauth_smtp_api_key et
# voidauth_from_mail, group_vars/all/vars.yml).
PDS_EMAIL_SMTP_URL=smtps://noreply@hiwasa.fr:{{ voidauth_smtp_api_key }}@smtp.protonmail.ch:587
PDS_EMAIL_FROM_ADDRESS={{ voidauth_from_mail }}

LOG_ENABLED=true
