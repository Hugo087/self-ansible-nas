WIREGUARD_PRIVATE_KEY={{ gluetun_wireguard_private_key }}
TZ=Europe/Paris
VPN_SERVICE_PROVIDER={{ gluetun_vpn_service_provider }}
VPN_TYPE={{ gluetun_vpn_type }}
SERVER_COUNTRIES={{ gluetun_server_countries }}
VPN_PORT_FORWARDING=on
FIREWALL_VPN_INPUT_PORTS=6881

VPN_PORT_FORWARDING_UP_COMMAND={% raw %}/bin/sh -c 'wget -O- -nv --retry-connrefused --post-data "json={\"listen_port\":{{PORT}},\"current_network_interface\":\"{{VPN_INTERFACE}}\",\"random_port\":false,\"upnp\":false}" http://127.0.0.1:8080/api/v2/app/setPreferences'{% endraw %} 

VPN_PORT_FORWARDING_DOWN_COMMAND={% raw %}/bin/sh -c 'wget -O- -nv --retry-connrefused --post-data "json={\"listen_port\":0,\"current_network_interface\":\"lo\"}" http://127.0.0.1:8080/api/v2/app/setPreferences'{% endraw %}
