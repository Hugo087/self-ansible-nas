---
# Copie ce fichier en group_vars/vault.yml, remplis les vraies valeurs,
# PUIS chiffre-le avant de committer quoi que ce soit :
#
#   cp group_vars/vault.yml.example group_vars/vault.yml
#   $EDITOR group_vars/vault.yml
#   ansible-vault encrypt group_vars/all/vault.yml
#
# Lance ensuite le playbook avec --ask-vault-pass (ou --vault-password-file).
# Ne JAMAIS committer group_vars/vault.yml en clair.

# --- VoidAuth — déprécié, conservé en commentaire pour référence ---
vault_db_password: ""
vault_voidauth_storage_key: ""
vault_voidauth_smtp_api_key: ""

# --- Samba ---
samba_accounts:
